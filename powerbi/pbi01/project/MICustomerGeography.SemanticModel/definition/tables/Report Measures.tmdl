	/// Operator-facing unit, source, vintage, definition, and interpretation.
	measure 'Metric Help' = [Selected Metric Unit] & " · " & [Selected Metric Source] & " · " & [Selected Metric Vintage] & UNICHAR(10) & [Selected Metric Definition] & UNICHAR(10) & [Selected Metric Interpretation]
		lineageTag: b62651bd-fd6d-579d-a94f-3c3f51e506ef

	/// Dynamic five-step scale plus neutral unavailable state.
	measure 'Five-Step Legend' = [Legend Step 1] & "   " & [Legend Step 2] & "   " & [Legend Step 3] & "   " & [Legend Step 4] & "   " & [Legend Step 5] & UNICHAR(10) & [Legend No Data]
		lineageTag: 88fa95d5-3eaa-54ca-9285-56a1f38b4a24

