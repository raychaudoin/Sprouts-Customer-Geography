	measure 'Selected Tract Context' = IF([Selected Tract Count] = 1, [Support Row 1 Label] & ": " & [Support Row 1 Value] & UNICHAR(10) & [Support Row 2 Label] & ": " & [Support Row 2 Value] & UNICHAR(10) & [Support Row 3 Label] & ": " & [Support Row 3 Value] & UNICHAR(10) & [Support Row 4 Label] & ": " & [Support Row 4 Value] & UNICHAR(10) & [Support Row 5 Label] & ": " & [Support Row 5 Value] & UNICHAR(10) & [Support Row 6 Label] & ": " & [Support Row 6 Value], BLANK())
