		        MetricKey,
		        "customer_fit_percentile", SELECTEDVALUE('Michigan Tracts'[QA / Missingness Status]),
		        "household_opportunity_5_mile", SELECTEDVALUE('Michigan Tracts'[QA / Missingness Status]),
		        "modeled_target_mass_percentile", SELECTEDVALUE('Michigan Tracts'[QA / Missingness Status]),
		        "median_household_income", SELECTEDVALUE('Michigan Public Context'[Median Household Income Status Detail]),
