/// Light PBI-02 presentation measures; all analytical values remain accepted upstream authority.
table 'Report Measures'
	lineageTag: f21d8a54-2c4f-5983-8a33-3291509a5a24

	column Anchor
		dataType: string
		isHidden
		lineageTag: 0f8c8f41-6bf2-5d7b-b6d5-c596ac9e37e1
		summarizeBy: none
		sourceColumn: Anchor

		annotation SummarizationSetBy = Automatic

	/// Statewide tract count after report filters.
	measure 'Total Tracts' = COUNTROWS('Michigan Tracts')
		formatString: #,0
		lineageTag: 1c5a770c-0302-56c1-8256-7b7c5befa237

	/// Tracts with authoritative MODEL-13 scores.
	measure 'Computable Tracts' = CALCULATE(COUNTROWS('Michigan Tracts'), 'Michigan Tracts'[Computability Status] = "MODEL_SCORE_COMPUTABLE")
		formatString: #,0
		lineageTag: e2817e05-040b-5569-945d-9433022ec832

	/// Tracts explicitly noncomputable in MODEL-13.
	measure 'Noncomputable Tracts' = [Total Tracts] - [Computable Tracts]
		formatString: #,0
		lineageTag: 8a0b1f33-de41-5278-9eb0-f3e35b7261f4

	/// Tracts with descriptive boundary support truncation.
	measure 'Support-Truncated Tracts' = CALCULATE(COUNTROWS('Michigan Tracts'), 'Michigan Tracts'[Any Support Truncation] = TRUE())
		formatString: #,0
		lineageTag: 429bea4e-8f62-5bc1-848d-768412580b67

	/// DATA-04 public-context tract rows after report filters.
	measure 'Public Context Rows' = COUNTROWS('Michigan Public Context')
		formatString: #,0
		lineageTag: 7f8845af-3236-59e6-be06-7d059d18a8a1

	/// Reconciled public GEOID count.
	measure 'Public Context Reconciled Keys' = COUNTROWS(INTERSECT(VALUES('Michigan Tracts'[GEOID]), VALUES('Michigan Public Context'[GEOID])))
		formatString: #,0
		lineageTag: 811b65cd-786d-5c9e-84b1-380a7bf8be88

	/// Stable selected catalog key.
	measure 'Selected Metric Key' = SELECTEDVALUE('Metric Selector'[Metric Key], "customer_fit_percentile")
		lineageTag: a3378bd4-15d9-551b-a864-6ce369adf477

	/// Operator selected map-layer label.
	measure 'Selected Metric Label' = SELECTEDVALUE('Metric Selector'[Metric], "Customer Fit Percentile")
		lineageTag: 86a8396d-ff55-54ea-a107-bae1d687cadc

	measure 'Selected Metric Short Name' = SELECTEDVALUE('Metric Selector'[Short Name], "Customer Fit")
		lineageTag: cb62c554-39d7-5952-8a81-070482286fc7

	measure 'Selected Metric Unit' = SELECTEDVALUE('Metric Selector'[Unit], "statewide percentile")
		lineageTag: af49d473-0c79-5327-b285-15a44360010b

	measure 'Selected Metric Format Policy' = SELECTEDVALUE('Metric Selector'[Format Policy], "percentile_1")
		lineageTag: ba8bdfdc-8be4-54d9-ab9f-d3e3134ea102

	measure 'Selected Metric Definition' = SELECTEDVALUE('Metric Selector'[Definition], "Percentile position of the accepted customer-fit public-data proxy among computable Michigan tracts.")
		lineageTag: c443c701-2e0e-5767-85f0-b953bddd15b6

	measure 'Selected Metric Interpretation' = SELECTEDVALUE('Metric Selector'[Interpretation], "Use as relative statewide decision support. It is not Sprouts' proprietary customer model and is not a final site recommendation.")
		lineageTag: 0091bee6-fdd0-5f26-8639-6b91298eff5e

	measure 'Selected Metric Source' = SELECTEDVALUE('Metric Selector'[Source Label], "Accepted MODEL-13 Michigan public-data proxy output")
		lineageTag: 63f28e05-67df-5a37-9182-4e7648939613

	measure 'Selected Metric Vintage' = SELECTEDVALUE('Metric Selector'[Vintage Label], "2024 public-source inputs")
		lineageTag: 3eb4620e-d496-51a6-ae99-0958d819e1c7

	measure 'Selected Metric Scale Policy' = SELECTEDVALUE('Metric Selector'[Scale Policy], "fixed_0_100")
		lineageTag: e3e1836d-778f-5896-a8b5-5a8c469335e9

	measure 'Selected Metric Availability Category' = SELECTEDVALUE('Metric Selector'[Availability Category], "model13_computability")
		lineageTag: ca668b8c-4626-56fc-ad57-11d6c69f048c

	measure 'Selected Metric Warning Policy' = SELECTEDVALUE('Metric Selector'[Contextual Warning Policy], "model_noncomputability_and_relevant_support")
		lineageTag: 87cbe764-d517-568f-9b5e-c35430579a36

	/// Presentation-only switch across distinct authoritative fields.
	measure 'Selected Metric Value' = ```
		VAR MetricKey = [Selected Metric Key]
		RETURN
		    SWITCH(
		        MetricKey,
		        "customer_fit_percentile", MAX('Michigan Tracts'[Customer Fit Percentile]),
		        "household_opportunity_5_mile", MAX('Michigan Tracts'[Household Opportunity]),
		        "modeled_target_mass_percentile", MAX('Michigan Tracts'[Modeled Target Mass Percentile]),
		        "median_household_income", MAX('Michigan Public Context'[Median Household Income]),
		        "per_capita_income", MAX('Michigan Public Context'[Per Capita Income]),
		        "civilian_labor_force_share", MAX('Michigan Public Context'[Civilian Labor Force Share]),
		        "employment_rate", MAX('Michigan Public Context'[Employment Rate]),
		        "bachelors_or_higher_share", MAX('Michigan Public Context'[Bachelor's Degree or Higher Share]),
		        "owner_occupancy_share", MAX('Michigan Public Context'[Owner-Occupied Housing Share]),
		        "vacancy_share", MAX('Michigan Public Context'[Vacant Housing Unit Share]),
		        "median_home_value", MAX('Michigan Public Context'[Median Home Value]),
		        "median_gross_rent", MAX('Michigan Public Context'[Median Gross Rent]),
		        "average_household_size", MAX('Michigan Public Context'[Average Household Size]),
		        "no_vehicle_household_share", MAX('Michigan Public Context'[No-Vehicle Household Share]),
		        "drive_alone_commuter_share", MAX('Michigan Public Context'[Drive-Alone Commuter Share]),
		        "work_from_home_commuter_share", MAX('Michigan Public Context'[Work-from-Home Commuter Share]),
		        BLANK()
		    )
		```
		formatString: 0.00
		lineageTag: 5db80892-4fe9-5ec8-b5c8-34819a900ab7

	/// Selected source-specific availability status.
	measure 'Selected Metric Status' = ```
		VAR MetricKey = [Selected Metric Key]
		RETURN
		    SWITCH(
		        MetricKey,
		        "customer_fit_percentile", SELECTEDVALUE('Michigan Tracts'[Computability Status]),
		        "household_opportunity_5_mile", IF(ISBLANK(MAX('Michigan Tracts'[Household Opportunity])), "missing", "valid"),
		        "modeled_target_mass_percentile", SELECTEDVALUE('Michigan Tracts'[Computability Status]),
		        "median_household_income", SELECTEDVALUE('Michigan Public Context'[Median Household Income Status]),
		        "per_capita_income", SELECTEDVALUE('Michigan Public Context'[Per Capita Income Status]),
		        "civilian_labor_force_share", SELECTEDVALUE('Michigan Public Context'[Civilian Labor Force Share Status]),
		        "employment_rate", SELECTEDVALUE('Michigan Public Context'[Employment Rate Status]),
		        "bachelors_or_higher_share", SELECTEDVALUE('Michigan Public Context'[Bachelor's Degree or Higher Share Status]),
		        "owner_occupancy_share", SELECTEDVALUE('Michigan Public Context'[Owner-Occupied Housing Share Status]),
		        "vacancy_share", SELECTEDVALUE('Michigan Public Context'[Vacant Housing Unit Share Status]),
		        "median_home_value", SELECTEDVALUE('Michigan Public Context'[Median Home Value Status]),
		        "median_gross_rent", SELECTEDVALUE('Michigan Public Context'[Median Gross Rent Status]),
		        "average_household_size", SELECTEDVALUE('Michigan Public Context'[Average Household Size Status]),
		        "no_vehicle_household_share", SELECTEDVALUE('Michigan Public Context'[No-Vehicle Household Share Status]),
		        "drive_alone_commuter_share", SELECTEDVALUE('Michigan Public Context'[Drive-Alone Commuter Share Status]),
		        "work_from_home_commuter_share", SELECTEDVALUE('Michigan Public Context'[Work-from-Home Commuter Share Status]),
		        "missing"
		    )
		```
		lineageTag: 07cc6f43-d01e-533e-a7b5-4ef50143e414

	/// Selected DATA-04 margin of error when applicable.
	measure 'Selected Metric MOE' = ```
		VAR MetricKey = [Selected Metric Key]
		RETURN
		    SWITCH(
		        MetricKey,
		        "customer_fit_percentile", BLANK(),
		        "household_opportunity_5_mile", BLANK(),
		        "modeled_target_mass_percentile", BLANK(),
		        "median_household_income", MAX('Michigan Public Context'[Median Household Income MOE]),
		        "per_capita_income", MAX('Michigan Public Context'[Per Capita Income MOE]),
		        "civilian_labor_force_share", MAX('Michigan Public Context'[Civilian Labor Force Share MOE]),
		        "employment_rate", MAX('Michigan Public Context'[Employment Rate MOE]),
		        "bachelors_or_higher_share", MAX('Michigan Public Context'[Bachelor's Degree or Higher Share MOE]),
		        "owner_occupancy_share", MAX('Michigan Public Context'[Owner-Occupied Housing Share MOE]),
		        "vacancy_share", MAX('Michigan Public Context'[Vacant Housing Unit Share MOE]),
		        "median_home_value", MAX('Michigan Public Context'[Median Home Value MOE]),
		        "median_gross_rent", MAX('Michigan Public Context'[Median Gross Rent MOE]),
		        "average_household_size", MAX('Michigan Public Context'[Average Household Size MOE]),
		        "no_vehicle_household_share", MAX('Michigan Public Context'[No-Vehicle Household Share MOE]),
		        "drive_alone_commuter_share", MAX('Michigan Public Context'[Drive-Alone Commuter Share MOE]),
		        "work_from_home_commuter_share", MAX('Michigan Public Context'[Work-from-Home Commuter Share MOE]),
		        BLANK()
		    )
		```
		formatString: 0.00
		lineageTag: 40dba468-75d8-5a77-881a-98efb680ed1e

	measure 'Selected Metric Status Detail' = ```
		VAR MetricKey = [Selected Metric Key]
