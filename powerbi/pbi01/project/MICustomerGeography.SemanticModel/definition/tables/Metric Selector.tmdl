						{"Modeled Target Mass Percentile", "modeled_target_mass_percentile", "MODEL13_MICHIGAN_POWER_BI_OUTPUT_CONTRACT_V1", "model_proxy", "Modeled Target Mass", 3, "statewide percentile", "percentile_1", "Percentile position of the accepted modeled target-mass output among computable Michigan tracts.", "Use only as relative statewide context. It is not a site-level forecast, final recommendation, or promise of sales.", "Accepted MODEL-13 Michigan modeled target-mass output", "2024 public-source inputs", "fixed_0_100", "model13_computability", "model_noncomputability_and_relevant_support"},
