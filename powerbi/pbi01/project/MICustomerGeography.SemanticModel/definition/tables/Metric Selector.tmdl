						{"Per Capita Income", "per_capita_income", "DATA04_MICHIGAN_PUBLIC_DATA_PARITY_SOURCE_CONTRACT_V1", "economic_capacity", "Per Capita Income", 5, "2024 inflation-adjusted dollars", "currency_0", "Aggregate income in the past 12 months divided by the tract population.", "A descriptive per-person income measure; it is not household income or a site forecast.", "U.S. Census Bureau, American Community Survey", "2020-2024 ACS 5-Year Detailed Tables", "statewide_valid_p02_p98", "data04_measure_status", "data04_measure_status_only"},
						{"Civilian Labor Force Share", "civilian_labor_force_share", "DATA04_MICHIGAN_PUBLIC_DATA_PARITY_SOURCE_CONTRACT_V1", "economic_capacity", "Labor Force Share", 6, "percent of population age 16+", "percent_1", "Civilian labor force as a share of the population age 16 years and over.", "A descriptive labor-force participation measure, not employment-to-population and not a score.", "U.S. Census Bureau, American Community Survey", "2020-2024 ACS 5-Year Detailed Tables", "statewide_valid_p02_p98", "data04_measure_status", "data04_measure_status_only"},
						{"Employment Rate", "employment_rate", "DATA04_MICHIGAN_PUBLIC_DATA_PARITY_SOURCE_CONTRACT_V1", "economic_capacity", "Employment Rate", 7, "percent of civilian labor force", "percent_1", "Employed civilians divided by the civilian labor force.", "This is the employment share of the civilian labor force, not an employment-to-population rate.", "U.S. Census Bureau, American Community Survey", "2020-2024 ACS 5-Year Detailed Tables", "statewide_valid_p02_p98", "data04_measure_status", "data04_measure_status_only"},
						{"Bachelor's Degree or Higher Share", "bachelors_or_higher_share", "DATA04_MICHIGAN_PUBLIC_DATA_PARITY_SOURCE_CONTRACT_V1", "education_socioeconomic_structure", "Bachelor's or Higher", 8, "percent of population age 25+", "percent_1", "People age 25 years and over with a bachelor's, master's, professional, or doctoral degree as a share of the age-25-plus population.", "A descriptive educational-attainment measure; it is not a direct customer identity or protected-class measure.", "U.S. Census Bureau, American Community Survey", "2020-2024 ACS 5-Year Detailed Tables", "statewide_valid_p02_p98", "data04_measure_status", "data04_measure_status_only"},
