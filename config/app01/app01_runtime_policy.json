    ]
  },
  "basemaps": {
    "default": "usgs_topo",
    "fallback": "local_neutral",
    "usgs_topo": {
      "label": "Topo",
      "tile_url": "https://basemap.nationalmap.gov/arcgis/rest/services/USGSTopo/MapServer/tile/{z}/{y}/{x}",
      "maxzoom": 16,
      "attribution": "Map services and data available from U.S. Geological Survey, National Geospatial Program."
    },
    "usgs_imagery_topo": {
      "label": "Imagery + Labels",
      "tile_url": "https://basemap.nationalmap.gov/arcgis/rest/services/USGSImageryTopo/MapServer/tile/{z}/{y}/{x}",
      "maxzoom": 16,
      "attribution": "USDA, USGS The National Map: Orthoimagery and US Topo."
    },
    "local_neutral": {
      "label": "Local neutral",
      "network_required": false,
      "attribution": "U.S. Census Bureau, 2024 TIGER/Line Shapefiles."
    }
  },
  "network_egress": {
    "allowed_external_hosts": ["basemap.nationalmap.gov"],
    "allowed_external_methods": ["GET"],
    "tile_path_pattern": "^/arcgis/rest/services/(USGSTopo|USGSImageryTopo)/MapServer/tile/[0-9]+/[0-9]+/[0-9]+$",
    "external_query_strings_permitted": false,
    "external_request_bodies_permitted": false,
    "external_application_headers_permitted": false,
    "geocoding": false,
    "routing": false,
    "traffic": false
  },
  "protected_boundary": {
    "evidence_context_forces_local_neutral": true,
    "evidence_context_restores_public_camera_before_online_basemap": true,
    "production_bundle_written_to_disk": false,
    "protected_request_logging": false
  },
  "telemetry": {
    "application_telemetry": false,
    "analytics": false,
    "crash_reporting": false,
    "remote_logging": false
  }
}
