{
  "$schema": "../../schemas/app01/runtime_policy.schema.json",
  "artifact_id": "APP01_LOCAL_FIRST_RUNTIME_POLICY_V1",
  "version": "1.0.0",
  "accepted_predecessor": "ARCH01_LOCAL_FIRST_PRESENTATION_RUNTIME_POLICY_V1",
  "topology": {
    "architecture": "static_browser_application_with_python_standard_library_loopback_server",
    "bind_host": "127.0.0.1",
    "default_port": 8767,
    "non_loopback_binding_permitted": false,
    "read_only": true,
    "query_strings_permitted": false
  },
  "renderer": {
    "name": "MapLibre GL JS",
    "version": "6.6.0",
    "runtime_cdn": false,
    "telemetry": false,
    "vendored_files": [
      {"path": "presentation/arch01/site/vendor/maplibre-gl/maplibre-gl.mjs", "sha256": "d84cb65fa75f07a972616cb4ee1902829ca053beae28f7be9b0889131c497afd"},
      {"path": "presentation/arch01/site/vendor/maplibre-gl/maplibre-gl-shared.mjs", "sha256": "34c2cb0330cec92e81c4fa7344e7008451442bbb9cca1da3465db4041a934073"},
      {"path": "presentation/arch01/site/vendor/maplibre-gl/maplibre-gl-worker.mjs", "sha256": "b081c9b3d0691d9d85552b5624f2601f69f24ed37573959d279d322e98e4ee2f"},
      {"path": "presentation/arch01/site/vendor/maplibre-gl/maplibre-gl.css", "sha256": "8e2dbbab312dc57656fbb76e9fa5308c75c9d7c7ba5808a7d55bcdb64cc813fa"},
