{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sprouts-customer-geography:readiness:development-readiness:v1",
  "title": "Development Readiness Mailbox",
  "description": "Strict repository-safe readiness snapshot for the Brainstorming to Development handoff.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "generated_at_utc",
    "repository",
    "protected_state",
    "preservation",
    "recovery",
    "prerequisites"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "snapshot_id": {
      "const": "development-readiness-v1"
    },
    "generated_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verified_commit",
        "worktree_state",
        "active_initiatives",
        "safe_work"
      ],
      "properties": {
        "verified_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "worktree_state": {
          "enum": [
            "CLEAN",
            "KNOWN_PRESERVED_WORK",
            "ATTENTION_NEEDED"
          ]
        },
        "active_initiatives": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/activeInitiative"
          }
        },
        "safe_work": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/safeWork"
          }
        }
      }
    },
    "protected_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_profile",
        "asset_catalog",
        "original_source_inventory",
        "evidence_ledger",
        "model13_authority",
        "app01_inputs"
      ],
      "properties": {
        "project_profile": {
          "enum": [
            "READY",
            "STALE",
            "MISSING",
            "INVALID"
          ]
        },
        "asset_catalog": {
          "enum": [
            "READY",
            "STALE",
            "UNRESOLVED"
          ]
        },
        "original_source_inventory": {
          "enum": [
            "READY",
            "INCOMPLETE",
            "UNRESOLVED"
          ]
        },
        "evidence_ledger": {
          "enum": [
            "READY",
            "INCOMPLETE",
            "UNRESOLVED"
          ]
        },
        "model13_authority": {
          "$ref": "#/$defs/registrationState"
        },
        "app01_inputs": {
          "$ref": "#/$defs/registrationState"
        }
      }
    },
    "preservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model14",
        "model15"
      ],
      "properties": {
        "model14": {
          "$ref": "#/$defs/preservationState"
        },
        "model15": {
          "$ref": "#/$defs/preservationState"
        }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fresh_session"
      ],
      "properties": {
        "fresh_session": {
          "enum": [
            "SUCCEEDED",
            "FAILED",
            "NOT_VERIFIED"
          ]
        }
      }
    },
    "prerequisites": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/prerequisite"
      }
    }
  },
  "$defs": {
    "initiativeId": {
      "type": "string",
      "pattern": "^(?:APP|ARCH|BI|DATA|DEPLOY|GEO|GOV|INTEGRATION|MARKETS|MODEL|PBI|PIPE|STORE|VALIDATE)-[0-9]{2,4}[A-Z]?$"
    },
    "activeInitiative": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initiative_id",
        "worktree_state",
        "push_state"
      ],
      "properties": {
        "initiative_id": {
          "$ref": "#/$defs/initiativeId"
        },
        "worktree_state": {
          "enum": [
            "CLEAN",
            "KNOWN_PRESERVED_WORK",
            "ATTENTION_NEEDED"
          ]
        },
        "push_state": {
          "enum": [
            "SYNCHRONIZED",
            "UNPUSHED_SAFE_WORK",
            "UNKNOWN"
          ]
        }
      }
    },
    "safeWork": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initiative_id",
        "state"
      ],
      "properties": {
        "initiative_id": {
          "$ref": "#/$defs/initiativeId"
        },
        "state": {
          "enum": [
            "UNCOMMITTED",
            "UNPUSHED",
            "UNCOMMITTED_AND_UNPUSHED",
            "PRESERVED"
          ]
        }
      }
    },
    "registrationState": {
      "enum": [
        "REGISTERED_RECOVERABLE",
        "REGISTERED_UNRECOVERABLE",
        "UNREGISTERED",
        "NOT_VERIFIED"
      ]
    },
    "preservationState": {
      "enum": [
        "PRESERVED",
        "ATTENTION_NEEDED",
        "NOT_VERIFIED"
      ]
    },
    "prerequisite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "status"
      ],
      "properties": {
        "code": {
          "enum": [
            "REPOSITORY_READINESS",
            "PROTECTED_PROJECT_PROFILE",
            "PROTECTED_ASSET_CATALOG",
            "ORIGINAL_SOURCE_INVENTORY",
            "EVIDENCE_LEDGER",
            "MODEL13_AUTHORITY",
            "APP01_INPUT_PACKAGE",
            "MODEL14_PRESERVATION",
            "MODEL15_PRESERVATION",
            "FRESH_SESSION_RECOVERY"
          ]
        },
        "status": {
          "enum": [
            "READY",
            "NEEDS_RUNWAY",
            "BLOCKED",
            "NOT_APPLICABLE"
          ]
        }
      }
    }
  }
}
