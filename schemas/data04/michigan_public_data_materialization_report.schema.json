{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sprouts-customer-geography:data04:michigan-public-data-materialization-report:v1",
  "title": "DATA-04 Michigan public-data materialization verification report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_id",
    "state",
    "contract_id",
    "contract_version",
    "contract_content_sha256",
    "state_name",
    "state_fips",
    "geography_level",
    "tract_count",
    "ordered_tract_inventory_sha256",
    "source_products",
    "household_evidence",
    "multivariate_evidence",
    "tiger_evidence",
    "tract_reconciliation",
    "downstream_geo_source_readiness",
    "downstream_model11_public_source_readiness",
    "missingness_policy",
    "protected_characteristic_policy",
    "protected_evidence_access"
  ],
  "properties": {
    "report_id": {"const": "DATA04_MICHIGAN_PUBLIC_DATA_PARITY_MATERIALIZATION_REPORT_V1"},
    "state": {"const": "VERIFIED"},
    "contract_id": {"const": "DATA04_MICHIGAN_PUBLIC_DATA_PARITY_SOURCE_CONTRACT_V1"},
    "contract_version": {"const": "1.0.0"},
    "contract_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "state_name": {"const": "Michigan"},
    "state_fips": {"const": "26"},
    "geography_level": {"const": "tract"},
    "tract_count": {"const": 3017},
    "ordered_tract_inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_products": {"type": "object"},
    "household_evidence": {"type": "object"},
    "multivariate_evidence": {"type": "object"},
    "tiger_evidence": {"type": "object"},
    "tract_reconciliation": {"type": "object"},
    "downstream_geo_source_readiness": {"type": "object"},
    "downstream_model11_public_source_readiness": {"type": "object"},
    "missingness_policy": {"type": "string", "minLength": 1},
    "protected_characteristic_policy": {"type": "string", "minLength": 1},
    "protected_evidence_access": {"type": "object"}
  }
}
