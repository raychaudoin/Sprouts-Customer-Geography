{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sprouts-customer-geography:data04:michigan-public-data-parity-source-contract:v1",
  "title": "DATA-04 Michigan public-data parity source contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "artifact_id",
    "version",
    "status",
    "controlling_decision",
    "purpose",
    "state_scope",
    "source_products",
    "accepted_acs_national_authority",
    "household_extraction",
    "multivariate_extraction",
    "tiger_source_authority",
    "tract_reconciliation",
    "output_contract",
    "downstream_readiness_contract",
    "protected_characteristic_policy",
    "protected_evidence_boundary",
    "hash_algorithm",
    "content_hash_semantics",
    "failure_behavior",
    "supersedes",
    "supersession_policy",
    "content_sha256"
  ],
  "properties": {
    "$schema": {"const": "../../schemas/data04/michigan_public_data_parity_source_contract.schema.json"},
    "artifact_id": {"const": "DATA04_MICHIGAN_PUBLIC_DATA_PARITY_SOURCE_CONTRACT_V1"},
    "version": {"const": "1.0.0"},
    "status": {"const": "active"},
    "controlling_decision": {"const": "DATA-04: Michigan Public-Data Parity Foundation"},
    "purpose": {"type": "string", "minLength": 1},
    "state_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state_name", "state_slug", "state_fips", "geography_level", "table_file_geo_id_prefix", "tract_geoid_pattern", "statewide", "observed_tract_count", "count_authority"],
      "properties": {
        "state_name": {"const": "Michigan"},
        "state_slug": {"const": "michigan"},
        "state_fips": {"const": "26"},
        "geography_level": {"const": "tract"},
        "table_file_geo_id_prefix": {"const": "1400000US26"},
        "tract_geoid_pattern": {"const": "^26[0-9]{9}$"},
        "statewide": {"const": true},
        "observed_tract_count": {"const": 3017},
        "count_authority": {"type": "string", "minLength": 1}
      }
    },
    "source_products": {"type": "object", "required": ["acs", "tiger"]},
    "accepted_acs_national_authority": {"type": "object", "required": ["household_manifest", "data03_contract", "multivariate_tables"]},
    "household_extraction": {"type": "object", "required": ["extraction_id", "table_id", "estimate_variable", "moe_variable", "source_estimate_field", "source_moe_field", "geography_selection", "expected_tract_count", "missingness"]},
    "multivariate_extraction": {"type": "object", "required": ["extraction_id", "accepted_table_count", "accepted_component_pair_count", "accepted_candidate_measure_count", "table_identity_sha256", "candidate_measure_identity_sha256", "special_value_contract_sha256", "derivation_contract_sha256", "metadata_identity_sha256", "geography_selection", "expected_tract_count", "expected_source_row_reconciliation"]},
    "tiger_source_authority": {"type": "object", "required": ["manifest_id", "manifest_path", "source_byte_sha256", "state_fips", "source_crs", "required_fields"]},
    "tract_reconciliation": {"type": "object", "required": ["canonical_key", "ordering", "tiger_uniqueness", "acs_table_equality", "missing_source_row", "present_noncomputable_value", "row_dropping"]},
    "output_contract": {"type": "object", "required": ["schema_version", "household_filename", "tiger_filename", "multivariate_directory", "multivariate_normalized_filename", "multivariate_candidate_filename", "verification_report_filename", "ready_filename", "overwrite", "ready_marker_last", "raw_and_generated_git_state"]},
    "downstream_readiness_contract": {"type": "object", "required": ["geo_source_requirements", "model11_public_source_requirements", "geo_methodology_change", "model_execution"]},
    "protected_characteristic_policy": {"type": "object", "required": ["data03_policy_preserved", "direct_proxy_recreation_prohibited", "excluded_bases", "all_candidate_measures_clear"]},
    "protected_evidence_boundary": {"type": "object", "required": ["public_data_only", "denied_evidence", "protected_filesystem_discovery"]},
    "hash_algorithm": {"const": "SHA-256"},
    "content_hash_semantics": {"type": "string", "minLength": 1},
    "failure_behavior": {"type": "string", "minLength": 1},
    "supersedes": {"type": "null"},
    "supersession_policy": {"type": "string", "minLength": 1},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
