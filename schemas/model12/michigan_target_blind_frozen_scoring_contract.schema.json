{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sprouts-customer-geography.local/schemas/model12/michigan_target_blind_frozen_scoring_contract.schema.json",
  "title": "MODEL-12 Michigan target-blind frozen scoring contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "artifact_id",
    "version",
    "status",
    "controlling_task",
    "purpose",
    "accepted_authority",
    "source_projection",
    "physical_location_identity",
    "public_feature_application",
    "frozen_scoring",
    "support_completeness",
    "generic_anchor_scorer",
    "future_transport_evaluation_freeze",
    "protected_execution",
    "interpretation_boundary",
    "hash_algorithm",
    "content_hash_semantics",
    "failure_behavior",
    "content_sha256"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "artifact_id": {"const": "MODEL12_MICHIGAN_TARGET_BLIND_FROZEN_SCORING_CONTRACT_V1"},
    "version": {"const": "1.0.0"},
    "status": {"enum": ["proposed_awaiting_acceptance", "accepted"]},
    "controlling_task": {"const": "MODEL-12: Michigan Target-Blind Seed Intake and Frozen Scoring"},
    "purpose": {"type": "string", "minLength": 1},
    "accepted_authority": {"type": "object"},
    "source_projection": {"type": "object"},
    "physical_location_identity": {"type": "object"},
    "public_feature_application": {"type": "object"},
    "frozen_scoring": {"type": "object"},
    "support_completeness": {"type": "object"},
    "generic_anchor_scorer": {"type": "object"},
    "future_transport_evaluation_freeze": {"type": "object"},
    "protected_execution": {"type": "object"},
    "interpretation_boundary": {"type": "object"},
    "hash_algorithm": {"const": "SHA-256"},
    "content_hash_semantics": {"type": "string", "minLength": 1},
    "failure_behavior": {"type": "string", "minLength": 1},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
