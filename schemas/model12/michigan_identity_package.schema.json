{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sprouts-customer-geography.local/schemas/model12/michigan_identity_package.schema.json",
  "title": "Protected MODEL-12 Michigan physical-location identity package",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "package_id", "version", "state", "contract_authority", "source_authority", "target_blind_projection", "identity_rules", "source_observations", "physical_locations", "aggregate_conformance", "target_access", "protected_handle_registry_identity"],
  "properties": {
    "$schema": {"const": "model12-michigan-physical-location-identity-package-v1"},
    "package_id": {"const": "MODEL12_MICHIGAN_PHYSICAL_LOCATION_IDENTITY_PACKAGE_V1"},
    "version": {"const": "1.0.0"},
    "state": {"const": "ready"},
    "contract_authority": {"type": "object"},
    "source_authority": {"type": "object"},
    "source_observations": {"type": "array", "minItems": 1},
    "physical_locations": {"type": "array", "minItems": 1},
    "target_blind_projection": {"type": "object"},
    "identity_rules": {"type": "object"},
    "aggregate_conformance": {"type": "object"},
    "target_access": {"type": "object"},
    "protected_handle_registry_identity": {"type": "string", "pattern": "^protected-handle-registry:sha256:[0-9a-f]{64}$"},
    "protected_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stable_package_identity": {"type": "string", "pattern": "^model12-identity:sha256:[0-9a-f]{64}$"}
  }
}
