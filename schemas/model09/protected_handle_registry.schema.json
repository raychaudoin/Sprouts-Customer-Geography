{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sprouts-customer-geography:model09:protected-handle-registry:v1",
  "title": "MODEL-09 protected exact-handle registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_id", "version", "protected_roots", "resources", "development_request"],
  "properties": {
    "registry_id": {"const": "MODEL09_PROTECTED_HANDLE_REGISTRY_V1"},
    "version": {"const": "1.0.0"},
    "protected_roots": {"type": "object", "minProperties": 1},
    "resources": {"type": "object", "minProperties": 1},
    "development_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pipe04_binding_handle", "pipe04_ready_marker_handle", "model10_package_handle", "model10_ready_marker_handle", "acs_source_handle", "tiger_source_handle", "model09_output_root_handle"],
      "properties": {
        "pipe04_binding_handle": {"type": "string", "pattern": "^phandle-"},
        "pipe04_ready_marker_handle": {"type": "string", "pattern": "^phandle-"},
        "model10_package_handle": {"type": "string", "pattern": "^phandle-"},
        "model10_ready_marker_handle": {"type": "string", "pattern": "^phandle-"},
        "acs_source_handle": {"type": "string", "pattern": "^phandle-"},
        "tiger_source_handle": {"type": "string", "pattern": "^phandle-"},
        "model09_output_root_handle": {"type": "string", "pattern": "^phandle-"}
      }
    }
  }
}
