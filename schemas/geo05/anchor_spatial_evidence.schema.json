{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sprouts-customer-geography.local/schemas/geo05/anchor_spatial_evidence.schema.json",
  "title": "GEO-05 later-anchor target-blind public spatial evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "state", "anchor", "containing_tract_geoid", "projected_anchor", "memberships", "support_completeness", "spatial_lineage"],
  "properties": {
    "schema_id": {"const": "GEO05_ANCHOR_SPATIAL_EVIDENCE_V1"},
    "state": {"const": "COMPUTABLE"},
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["opaque_anchor_identity", "opaque_anchor_lineage", "latitude", "longitude"],
      "properties": {
        "opaque_anchor_identity": {"type": "string", "minLength": 1},
        "opaque_anchor_lineage": {"type": "string", "minLength": 1},
        "latitude": {"type": "number", "minimum": -90, "maximum": 90},
        "longitude": {"type": "number", "minimum": -180, "maximum": 180}
      }
    },
    "containing_tract_geoid": {"type": "string", "pattern": "^26[0-9]{9}$"},
    "projected_anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["crs", "x_m", "y_m"],
      "properties": {
        "crs": {"const": "EPSG:5070"},
        "x_m": {"type": "number"},
        "y_m": {"type": "number"}
      }
    },
    "memberships": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["radius_m", "ordinary_member_count", "member_count", "containing_tract_forced", "member_geoids"],
        "properties": {
          "radius_m": {"type": "number", "exclusiveMinimum": 0},
          "ordinary_member_count": {"type": "integer", "minimum": 0},
          "member_count": {"type": "integer", "minimum": 1},
          "containing_tract_forced": {"type": "boolean"},
          "member_geoids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^26[0-9]{9}$"}}
        }
      }
    },
    "support_completeness": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["radius_m", "full_circle_area_m2", "area_inside_michigan_support_m2", "support_completeness_ratio", "extends_outside_michigan_support", "outside_support_area_m2", "anchor_to_support_boundary_m", "footprint_edge_margin_m", "footprint_quad_segs"],
        "properties": {
          "radius_m": {"type": "number", "exclusiveMinimum": 0},
          "full_circle_area_m2": {"type": "number", "exclusiveMinimum": 0},
          "area_inside_michigan_support_m2": {"type": "number", "minimum": 0},
          "support_completeness_ratio": {"type": "number", "minimum": 0, "maximum": 1},
          "extends_outside_michigan_support": {"type": "boolean"},
          "outside_support_area_m2": {"type": "number", "minimum": 0},
          "anchor_to_support_boundary_m": {"type": "number", "minimum": 0},
          "footprint_edge_margin_m": {"type": "number"},
          "footprint_quad_segs": {"const": 64}
        }
      }
    },
    "spatial_lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spatial_spec_id", "spatial_spec_content_sha256", "inventory_id", "inventory_sha256", "data04_contract_id", "tiger_manifest_id", "tiger_source_sha256", "source_crs", "target_crs", "operation_id", "operation_fingerprint_sha256", "runtime_provenance"],
      "properties": {
        "spatial_spec_id": {"const": "GEO05_MICHIGAN_STATEWIDE_SPATIAL_SUPPORT_SPEC_V1"},
        "spatial_spec_content_sha256": {"$ref": "#/$defs/sha256"},
        "inventory_id": {"const": "GEO05_MICHIGAN_STATEWIDE_SPATIAL_SUPPORT_INVENTORY_V1"},
        "inventory_sha256": {"$ref": "#/$defs/sha256"},
        "data04_contract_id": {"const": "DATA04_MICHIGAN_PUBLIC_DATA_PARITY_SOURCE_CONTRACT_V1"},
        "tiger_manifest_id": {"const": "DATA04_TIGER2024_MI_TRACT_SOURCE_MANIFEST_V1"},
        "tiger_source_sha256": {"$ref": "#/$defs/sha256"},
        "source_crs": {"const": "EPSG:4269"},
        "target_crs": {"const": "EPSG:5070"},
        "operation_id": {"const": "GEO03_EPSG4269_TO_EPSG5070_DIRECT_NAD83_CONUS_ALBERS_V1"},
        "operation_fingerprint_sha256": {"$ref": "#/$defs/sha256"},
        "runtime_provenance": {"type": "object"}
      }
    }
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
