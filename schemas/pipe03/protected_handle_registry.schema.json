{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sprouts-customer-geography:pipe03:protected-handle-registry:v1",
  "title": "PIPE03 protected handle registry (protected-local contract only)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_id",
    "version",
    "protected_roots",
    "resources",
    "binding_request",
    "target_source_authorities"
  ],
  "properties": {
    "registry_id": {"const": "PIPE03_PROTECTED_HANDLE_REGISTRY_V1"},
    "version": {"const": "1.0.0"},
    "protected_roots": {"type": "object", "minProperties": 1},
    "resources": {"type": "object", "minProperties": 1},
    "binding_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model04_package_handle",
        "model04_verification_material_handle",
        "wisconsin_development_target_workbook_handles",
        "binding_output_root_handle"
      ],
      "properties": {
        "model04_package_handle": {"type": "string", "pattern": "^phandle-"},
        "model04_verification_material_handle": {"type": "string", "pattern": "^phandle-"},
        "wisconsin_development_target_workbook_handles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^phandle-"}
        },
        "binding_output_root_handle": {"type": "string", "pattern": "^phandle-"}
      }
    },
    "target_source_authorities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "authority_id",
          "provenance_class",
          "source_workbook_identity",
          "workbook_handle",
          "byte_hash_permitted",
          "projection"
        ],
        "properties": {
          "authority_id": {"type": "string", "minLength": 1},
          "provenance_class": {"type": "string", "minLength": 1},
          "source_workbook_identity": {"type": "string", "minLength": 1},
          "workbook_handle": {"type": "string", "pattern": "^phandle-"},
          "byte_hash_permitted": {"const": false},
          "projection": {"type": "object"}
        }
      }
    }
  }
}
