{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sprouts-customer-geography:pipe03:wisconsin-development-target-access-binding:v1",
  "title": "PIPE03 Wisconsin development target access binding (protected-local)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "package_id",
    "version",
    "binding_run_id",
    "state",
    "model04_authority",
    "model05_authority",
    "model08_authority",
    "target_source_authorities",
    "eligible_wisconsin_cohort",
    "minimum_target_projection",
    "consumption_semantics",
    "protected_handle_registry_identity",
    "finalization",
    "supersedes",
    "supersession_policy",
    "protected_content_sha256",
    "stable_binding_identity",
    "protected_content_hash_semantics"
  ],
  "properties": {
    "$schema": {"const": "pipe03-wisconsin-development-target-access-binding-v1"},
    "package_id": {"const": "PIPE03_WISCONSIN_DEVELOPMENT_TARGET_ACCESS_BINDING_V1"},
    "version": {"type": "string", "pattern": "^1\\.0\\.[0-9]+$"},
    "binding_run_id": {"type": "string", "pattern": "^p3bind-[A-Za-z0-9_-]+$"},
    "state": {"const": "ready"},
    "model04_authority": {"type": "object"},
    "model05_authority": {"type": "object"},
    "model08_authority": {"type": "object"},
    "target_source_authorities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "authority_id",
          "provenance_class",
          "source_workbook_identity",
          "workbook_handle",
          "whole_workbook_hash_computed",
          "sheet_name",
          "projection_id",
          "projection_version"
        ],
        "properties": {
          "whole_workbook_hash_computed": {"const": false}
        }
      }
    },
    "eligible_wisconsin_cohort": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "physical_location_id",
          "source_workbook_identity",
          "source_sheet",
          "source_row",
          "lineage_key",
          "forecast_vintage",
          "market",
          "identity_state",
          "evidence_role",
          "target_view_state"
        ],
        "properties": {
          "physical_location_id": {"type": "string", "minLength": 1},
          "source_workbook_identity": {"type": "string", "minLength": 1},
          "source_sheet": {"type": "string", "minLength": 1},
          "source_row": {"type": "integer", "minimum": 2},
          "lineage_key": {"type": "string", "minLength": 1},
          "market": {"enum": ["milwaukee", "madison"]},
          "forecast_vintage": {"type": "integer"},
          "identity_state": {"not": {"const": "AMBIGUOUS_IDENTITY"}},
          "evidence_role": {"type": "string", "minLength": 1},
          "target_view_state": {"enum": ["SEALED", "DEVELOPMENT_CONSUMED"]}
        }
      }
    },
    "minimum_target_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projection_id",
        "version",
        "default_deny",
        "allowed_fields",
        "denied_scope",
        "rows",
        "target_access_audit"
      ],
      "properties": {
        "projection_id": {"const": "MODEL09_MINIMUM_WISCONSIN_DEVELOPMENT_TARGET_PROJECTION_V1"},
        "version": {"const": "1.0.0"},
        "default_deny": {"const": true},
        "allowed_fields": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 3,
          "maxItems": 3
        },
        "denied_scope": {"type": "array", "minItems": 1},
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "physical_location_id",
              "lineage_key",
              "forecast_vintage",
              "isolated_sales"
            ],
            "properties": {
              "physical_location_id": {"type": "string", "minLength": 1},
              "lineage_key": {"type": "string", "minLength": 1},
              "forecast_vintage": {"type": "integer"},
              "isolated_sales": {
                "type": "string",
                "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[Ee][+-]?[0-9]+)?$"
              }
            }
          }
        },
        "target_access_audit": {"type": "object"}
      }
    },
    "consumption_semantics": {"type": "object"},
    "protected_handle_registry_identity": {"type": "string", "minLength": 1},
    "finalization": {"type": "object"},
    "supersession_policy": {"type": "string", "minLength": 1},
    "protected_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stable_binding_identity": {"type": "string", "pattern": "^pipe03-binding:sha256:[0-9a-f]{64}$"},
    "protected_content_hash_semantics": {"type": "string", "minLength": 1},
    "supersedes": {"type": ["string", "null"]}
  }
}
