{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sprouts-customer-geography.local/schemas/app01/evidence_context_bundle.schema.json",
  "title": "APP-01 local-only Seed Context presentation bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "artifact_id", "version", "data_mode", "local_only", "external_transmission_permitted", "row_count", "rows"],
  "properties": {
    "$schema": {"const": "app01-evidence-context-bundle-v1"},
    "artifact_id": {"const": "APP01_SPROUTS_EVIDENCE_CONTEXT_BUNDLE_V1"},
    "version": {"const": "1.0.0"},
    "data_mode": {"enum": ["synthetic_validation", "accepted_real"]},
    "local_only": {"const": true},
    "external_transmission_permitted": {"const": false},
    "row_count": {"type": "integer", "minimum": 1},
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "latitude", "longitude", "isolated_sales", "frozen_prediction", "successor_prediction", "absolute_log_error", "household_opportunity", "customer_fit_proxy", "modeled_target_mass", "support_truncation", "qa_status"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "latitude": {"type": "number", "minimum": -90, "maximum": 90},
          "longitude": {"type": "number", "minimum": -180, "maximum": 180},
          "isolated_sales": {"type": ["number", "null"]},
          "frozen_prediction": {"type": ["number", "null"]},
          "successor_prediction": {"type": ["number", "null"]},
          "absolute_log_error": {"type": ["number", "null"], "minimum": 0},
          "household_opportunity": {"type": ["number", "null"], "minimum": 0},
          "customer_fit_proxy": {"type": ["number", "null"]},
          "modeled_target_mass": {"type": ["number", "null"]},
          "support_truncation": {"type": "boolean"},
          "qa_status": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
